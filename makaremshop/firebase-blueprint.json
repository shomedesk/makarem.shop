{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer order placed for curbside vehicle pickup or nearby neighborhood delivery",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "description": "Unique human-friendly order identifier e.g. MAK-1024 or #408",
          "maxLength": 64
        },
        "orderType": {
          "type": "string",
          "enum": ["curbside", "neighborhood_delivery"],
          "description": "Order mode: storefront curbside car pickup or nearby apartment/villa delivery"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full or display name",
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer contact phone or mobile number",
          "maxLength": 30
        },
        "vehicleNumber": {
          "type": "string",
          "description": "Car plate number, make/model, or parking bay for curbside orders",
          "maxLength": 100
        },
        "parkingSpot": {
          "type": "string",
          "description": "Specific storefront parking spot or bay description",
          "maxLength": 100
        },
        "houseNumber": {
          "type": "string",
          "description": "House, villa, building, floor or flat number for neighborhood delivery",
          "maxLength": 200
        },
        "locationCoordinates": {
          "type": "string",
          "description": "Pinpointed GPS coordinates and accuracy formatted as string or JSON",
          "maxLength": 500
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "card", "online"],
          "description": "Selected payment method: Cash, Card (POS terminal), or Online/Mobile transfer"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "received"],
          "description": "Status of payment confirmation"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "ready", "completed", "cancelled"],
          "description": "Order lifecycle status: pending -> processing -> ready -> completed"
        },
        "items": {
          "type": "string",
          "description": "Serialized list of grocery items with quantities, units, and prices",
          "maxLength": 10000
        },
        "customNotes": {
          "type": "string",
          "description": "Customer notes or handwritten grocery list requests",
          "maxLength": 1000
        },
        "subtotal": {
          "type": "number",
          "description": "Subtotal amount in local currency (SAR)"
        },
        "tax": {
          "type": "number",
          "description": "Tax or VAT amount"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order amount payable in SAR"
        },
        "salesplaySyncStatus": {
          "type": "string",
          "enum": ["pending", "synced", "failed", "skipped"],
          "description": "SalesPlay POS integration synchronization status"
        },
        "salesplayReceiptId": {
          "type": "string",
          "description": "Receipt or transaction reference returned by SalesPlay POS API",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp ISO string or server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp ISO string or server timestamp"
        }
      },
      "required": [
        "orderNumber",
        "orderType",
        "customerName",
        "customerPhone",
        "paymentMethod",
        "paymentStatus",
        "status",
        "totalAmount",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Grocery store product item available for quick selection and inventory tracking",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "English name of product",
          "maxLength": 120
        },
        "arabicName": {
          "type": "string",
          "description": "Arabic name of product",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Category e.g. Dairy, Bakery, Beverages, Fresh, Pantry",
          "maxLength": 60
        },
        "price": {
          "type": "number",
          "description": "Unit price in SAR"
        },
        "unit": {
          "type": "string",
          "description": "Selling unit: pcs, kg, pack, bottle, carton",
          "maxLength": 30
        },
        "stock": {
          "type": "number",
          "description": "Current on-hand inventory count"
        },
        "barcode": {
          "type": "string",
          "description": "Product EAN/UPC barcode",
          "maxLength": 50
        },
        "salesplayItemId": {
          "type": "string",
          "description": "Mapped SalesPlay POS product ID",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last inventory sync timestamp"
        }
      },
      "required": ["name", "price", "unit", "category"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store profile, location for GPS pinpointing, and SalesPlay POS connection status",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string",
          "description": "Makarem Al-Khair Modern",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "isOpen": {
          "type": "string",
          "maxLength": 10
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "salesplayConnected": {
          "type": "string",
          "maxLength": 20
        }
      },
      "required": ["storeName"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Real-time customer curbside and neighborhood delivery orders"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Store inventory catalog synced with SalesPlay POS"
    },
    "/store_settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store profile and configuration parameters"
    }
  }
}
